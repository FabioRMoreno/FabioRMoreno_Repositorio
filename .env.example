# Copie este arquivo para .env e preencha os valores.

# Banco de dados SQLite (arquivo único, fácil de fazer backup)
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar o cookie de sessão da professora (gerar um valor aleatório longo)
SESSION_SECRET="gere-um-valor-aleatorio-longo"

# Hash bcrypt da senha da professora (NUNCA colocar a senha em texto puro).
# Gerar com: node scripts/hash-password.mjs "sua-senha-aqui"
# ATENÇÃO: o script já devolve o valor com os "$" escapados (\$), porque o
# Next.js expande "$algo" no .env — colar o hash bcrypt sem escapar quebra o login.
PROFESSORA_PASSWORD_HASH=""
